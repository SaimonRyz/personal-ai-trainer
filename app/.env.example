# Template only. The future private .env must be owner-readable and ignored by Git.
# The approved local immutable image IDs are set only after the final candidate gate.
TRAINER_ALPHA_API_IMAGE=sha256:replace-with-approved-api-image-id
TRAINER_ALPHA_POSTGRES_IMAGE=sha256:replace-with-approved-postgres-image-id
TRAINER_POSTGRES_ADMIN_PASSWORD=replace-with-unique-local-admin-secret
TRAINER_DATABASE_APP_PASSWORD=replace-with-unique-local-app-secret
TRAINER_DATABASE_MIGRATOR_PASSWORD=replace-with-unique-local-migrator-secret
TRAINER_API_TOKEN=replace-with-unique-local-api-token-at-least-32-chars
# Optional owner-only verifier must never be exposed to the MCP process.
# TRAINER_OWNER_VERIFIER_TOKEN=replace-with-a-different-owner-only-secret
TRAINER_E1RM_BENCH_EXERCISE_IDS=[]
TRAINER_E1RM_BENCH_GRIP_CONDITIONS=[]
